# Copy to .env and fill in your own values. Never commit .env.
# Every variable is optional until you need the feature behind it.

# Email verification support (OTP / magic links): a domain whose catch-all
# forwards to this IMAP inbox. Without it, personas treat "check your email"
# walls as drop-off points.
LEAKDOWN_IMAP_HOST=
LEAKDOWN_IMAP_USER=
LEAKDOWN_IMAP_PASS=
LEAKDOWN_MAIL_DOMAIN=
# Optional, for a non-Gmail host: the port, and TLS off with exactly "false".
LEAKDOWN_IMAP_PORT=
LEAKDOWN_IMAP_TLS=

# Optional: a module that answers the yes/no rulings (goal reached, flow
# checkpoints, --expect values worded differently) instead of the AI CLI.
# It must export createJudge(). Unset, the AI CLI answers them.
LEAKDOWN_JUDGE=

# Website orders (--orders / --order): the Railway production URL of the
# request site, and the site's ORDERS_TOKEN.
LEAKDOWN_ORDERS_URL=
LEAKDOWN_ORDERS_TOKEN=changeme
